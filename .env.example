# Server Configuration
PORT=3000

# Directory Paths
SOURCE_DIR=./source
OUTPUT_DIR=./output

# Activity Filter
FILTER_TYPE=Running

# Strava
ACTIVITY_LOOKUP_DAYS=30
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_EXPIRES_AT=

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_LEGACY_API_BASE_URL=

# Draw Options - Image Dimensions
IMAGE_SIZE=500

# Draw Options - Styling
STROKE_WIDTH=5
ASPECT_RATIO=1.2

# Draw Options - Colors
TRACK_COLOR="#b7d05b"
SPECIAL_COLOR="#e22"

# Draw Options - Offsets
OFFSET_X=0
OFFSET_Y=0
